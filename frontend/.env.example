# true — данные из src/api/mocks, false — с сервера «Ответов» через прокси Vite
VITE_USE_MOCKS=false

# Только для разработки вне Telegram: initData, подписанный токеном бота.
# Его использует и мок SDK (mockEnv.ts), и запросы к бэкенду.
# Сгенерировать в папке бэкенда: go run ./cmd/initdata -id 12345 -first-name Dev -username dev
# Живёт столько, сколько TG_INITDATA_MAX_AGE у бэкенда (по умолчанию 24 часа).
VITE_DEV_INIT_DATA=
